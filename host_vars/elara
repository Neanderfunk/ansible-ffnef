  # Eindeutige AS-Nummer des Netzwerk
  as_number: 65411
  # IPv4 Adressraum
  v4_network: 10.0.0.0/8
  # IPv6 adressraum
  v6_network: 2a03:2260:100c::/48
  # IPv6 anycast ::ac1 in decimal
  v6_anycast: 2753

# Verwendung bei bird6
ipv6backbone64prefixstr: "2a03:2260:100c::"


